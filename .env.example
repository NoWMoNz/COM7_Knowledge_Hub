# ---------- Supabase ----------
# Where: Supabase Dashboard > Project Settings > API. PUBLIC (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
# PUBLIC. Anon key; access is limited by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. NEVER prefix with NEXT_PUBLIC_. Used by the bootstrap script and admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Gemini AI (used from Phase 3) ----------
# SECRET. Server only. Where: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------- Application ----------
# PUBLIC base URL, used for password-reset redirect links. e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Initial administrator ----------
# Comma-separated admin emails created/promoted by: npm run bootstrap-admin
BOOTSTRAP_ADMIN_EMAILS=
# SECRET. Initial password for newly created bootstrap admins (min 12 chars). Change after first login.
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- Background processing ----------
# SECRET. Shared secret for POST /api/jobs/process (cron / manual sweep of queued or stuck jobs). Generate a long random string.
JOB_RUNNER_SECRET=

# ---------- AI tuning (all optional; defaults shown) ----------
# Gemini model ids. Embeddings are stored as 768-dim vectors; changing the embedding model requires re-indexing documents.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Thinking before answering (chat only): minimal | low | medium | high | default (send nothing). Lower = faster, cheaper.
GEMINI_THINKING_LEVEL=low
# Max chunks sent to the model, and the minimum cosine similarity (0-1) for a chunk to count as evidence. Tune with real documents.
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.5

# Optional OCR for scanned PDFs. "gemini" sends the PDF to Google Gemini for transcription (same provider as embeddings); "none" disables it.
OCR_PROVIDER=none
